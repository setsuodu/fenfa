# Fenfa production env — copy to .env and edit
# docker compose -f docker-compose.prod.yml up -d

# Host port mapping
FENFA_HOST_PORT=8000

# Public domain (MUST set for QR / iOS manifest)
FENFA_PRIMARY_DOMAIN=https://your-domain.com

# Tokens (change these!)
FENFA_ADMIN_TOKEN=change-me-admin
FENFA_UPLOAD_TOKEN=change-me-upload

# Optional: override image repo if not setsuodu/fenfa
# GITHUB_REPOSITORY=youruser/fenfa
